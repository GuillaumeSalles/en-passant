{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "moduleSuffixes": [".native", ""],
    "paths": { "@/*": ["../../src/*"] }
  },
  "include": ["index.ts", "src/**/*.ts", "src/**/*.tsx"]
}
