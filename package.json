{
  "name": "en-passant",
  "version": "0.1.0",
  "private": true,
  "description": "Build and train your chess repertoire.",
  "license": "GPL-3.0-or-later",
  "author": "Guillaume Salles",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --host 127.0.0.1",
    "dev:vite": "vite",
    "generate:openings": "tsx scripts/generate-openings.ts",
    "merge:pgn": "bun scripts/merge-pgn.ts",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name enpassant",
    "test": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:offline": "npm run build && node scripts/run-e2e.mjs --offline",
    "type-check": "tsc --noEmit",
    "lint": "oxlint src tests scripts --deny-warnings -A no-unassigned-vars",
    "check:filenames": "node scripts/check-filenames.mjs",
    "check:guardrails": "node scripts/check-code-guardrails.mjs",
    "check": "npm run format:check && npm run lint && npm run check:filenames && npm run check:guardrails && npm run type-check && npm test -- --run && npm run build && npm run test:e2e && node scripts/run-e2e.mjs --offline",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@solidjs/router": "2.0.0-next.26",
    "@solidjs/web": "2.0.0-rc.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "solid-js": "2.0.0-rc.9",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.44",
    "@types/node": "^22.20.5",
    "eslint": "^10.7.0",
    "eslint-plugin-solid": "^0.14.5",
    "jsdom": "^26.0.0",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "postcss": "^8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^4.0.15",
    "wrangler": "^4.106.0"
  },
  "overrides": {
    "@solidjs/signals": "2.0.0-rc.9"
  }
}
